# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Project data: ignore raw and processed dataset contents, preserve directories
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model weights (checkpoints)
*.pt
*.pth

# Project outputs and checkpoints: ignore outputs, preserve directory, audit reports, and Track B artifacts
outputs/*
!outputs/.gitkeep
!outputs/audit/
!outputs/tables/
!outputs/tables/T7_corrected_cases.md
!outputs/trackb/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
